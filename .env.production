# Baked into the built bundle at `npm run build` time by Vite (this file is
# auto-loaded for the production mode `vite build` runs in by default — see
# .env.example's own comment on why only base URLs, never secrets, belong
# here). Points at chat.riskycfashion.com's nginx reverse-proxy path
# prefixes rather than raw backend IPs/ports, so the deployed site is
# same-origin with its own API calls (no CORS needed) and everything rides
# over real HTTPS/WSS instead of plain HTTP.
VITE_AUTH_SERVICE_URL=https://chat.riskycfashion.com/auth
VITE_MESSAGING_SERVICE_URL=https://chat.riskycfashion.com/messaging
VITE_MEDIA_SERVICE_URL=https://chat.riskycfashion.com/media
VITE_PRESENCE_SERVICE_URL=https://chat.riskycfashion.com/presence
VITE_SFU_SERVICE_URL=https://chat.riskycfashion.com/sfu
